# Database connection string for PostgreSQL (Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5433/todo_db?schema=public"

# Better Auth secret (minimum 32 characters recommended, e.g., generate with `openssl rand -hex 32` or similar random string)
BETTER_AUTH_SECRET="some_super_secret_key_at_least_32_characters"

# Base URL of the application
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
